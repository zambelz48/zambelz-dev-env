#!/usr/bin/env bats

setup() {
  load ai_helpers
  ai_test_setup
  ai_stub_agents

  ai_command check "Run the checks"
  ai_skill run-checks "Run every check"
  printf '#!/bin/sh\necho ok\n' >"$AI/skills/run-checks/run.sh"
  chmod +x "$AI/skills/run-checks/run.sh"
  cat >"$AI/mcp.json" <<'EOF'
{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "claude": {
        "headers": {
          "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY:-}"
        }
      }
    }
  }
}
EOF
  ai_hook_module guard 'def handle(event):
    return None'
  cat >"$AI/hooks/hooks.toml" <<'EOF'
[[hook]]
name = "guard"
module = "guard"
events = ["tool.before", "tool.after"]
summary = "Guards"
EOF
}

json_get() {
  "$MISE_DATA_DIR/shims/python3" -c "
import json, sys
data = json.load(open(sys.argv[1]))
for key in sys.argv[2:]:
    if key.isdigit():
        data = data[int(key)]
    else:
        data = data[key]
print(json.dumps(data))
" "$@"
}

@test "sync claude writes commands, skills, MCP and hook settings" {
  run "$AI/sync-ai.sh" claude

  [ "$status" -eq 0 ]
  [ -f "$REPO/.claude/commands/check.md" ]
  [ -f "$REPO/.claude/skills/run-checks/SKILL.md" ]
  [ -x "$REPO/.claude/skills/run-checks/run.sh" ]
  [ "$(json_get "$REPO/.mcp.json" mcpServers context7 headers CONTEXT7_API_KEY)" = "\"\${CONTEXT7_API_KEY:-}\"" ]
  [ "$(json_get "$REPO/.mcp.json" mcpServers context7 url)" = '"https://mcp.context7.com/mcp"' ]
  [ "$(json_get "$REPO/.claude/settings.json" enabledMcpjsonServers)" = '["context7"]' ]
  [ "$(json_get "$REPO/.claude/settings.json" hooks PreToolUse 0 matcher)" = '"Bash|Write|Edit|MultiEdit|NotebookEdit"' ]
  [ "$(json_get "$REPO/.claude/settings.json" hooks PreToolUse 0 hooks 0 command)" = "\"\\\"$AI/hook.sh\\\" claude PreToolUse\"" ]
  [ "$(json_get "$REPO/.claude/settings.json" hooks PreToolUse 0 hooks 0 onFailure)" = '"block"' ]
  [ "$(json_get "$REPO/.claude/settings.json" hooks PreToolUse 0 hooks 0 timeout)" = '90' ]
  [ "$(json_get "$REPO/.claude/settings.json" hooks PostToolUse 0 hooks 0 command)" = "\"\\\"$AI/hook.sh\\\" claude PostToolUse\"" ]
}

@test "a generated command keeps its description and body" {
  ai_command audit "Audit: the pinned tools" "Run zconf audit \$ARGUMENTS."

  run "$AI/sync-ai.sh" claude

  [ "$status" -eq 0 ]
  [ "$(cat "$REPO/.claude/commands/audit.md")" = "$(printf -- "---\ndescription: \"Audit: the pinned tools\"\n---\n\nRun zconf audit \$ARGUMENTS.")" ]
}

mtime_ns() {
  "$MISE_DATA_DIR/shims/python3" -c 'import os, sys; print(os.stat(sys.argv[1]).st_mtime_ns)' "$1"
}

@test "a second sync changes nothing" {
  "$AI/sync-ai.sh" claude >/dev/null
  before="$(mtime_ns "$REPO/.claude/settings.json")"

  run "$AI/sync-ai.sh" claude

  [ "$status" -eq 0 ]
  [[ "$output" != *"CHANGED"* ]]
  [[ "$output" == *"already up to date"* ]]
  [ "$(mtime_ns "$REPO/.claude/settings.json")" = "$before" ]
}

@test "a command removed from the source is removed" {
  ai_command audit "Audit"
  "$AI/sync-ai.sh" claude >/dev/null
  rm "$AI/commands/audit.md"

  run "$AI/sync-ai.sh" claude

  [ "$status" -eq 0 ]
  [[ "$output" == *"CHANGED: removed .claude/commands/audit.md"* ]]
  [ ! -e "$REPO/.claude/commands/audit.md" ]
}

@test "a file sync-ai did not write is reported and left alone" {
  "$AI/sync-ai.sh" claude >/dev/null
  printf 'mine\n' >"$REPO/.claude/commands/mine.md"

  run "$AI/sync-ai.sh" claude

  [ "$status" -eq 0 ]
  [[ "$output" == *"WARN: .claude/commands/mine.md is not generated by ai/sync-ai.sh"* ]]
  [ "$(cat "$REPO/.claude/commands/mine.md")" = "mine" ]
}

@test "a generated file edited by hand is backed up before it is rewritten" {
  "$AI/sync-ai.sh" claude >/dev/null
  printf 'edited\n' >"$REPO/.claude/commands/check.md"

  run "$AI/sync-ai.sh" claude

  [ "$status" -eq 0 ]
  [[ "$output" == *"CHANGED: .claude/commands/check.md: an existing file was moved to"* ]]
  [[ "$(cat "$REPO/.claude/commands/check.md")" == *"Run the checks"* ]]
  [ "$(cat "$REPO"/tmp/ai/backup/*/.claude/commands/check.md)" = "edited" ]
}

@test "a hand-made settings file is backed up on the first sync" {
  mkdir -p "$REPO/.claude"
  printf '{\n  "model": "opus"\n}\n' >"$REPO/.claude/settings.json"
  printf '{\n  "local": true\n}\n' >"$REPO/.claude/settings.local.json"

  run "$AI/sync-ai.sh" claude

  [ "$status" -eq 0 ]
  [[ "$output" == *"CHANGED: .claude/settings.json: an existing file was moved to"* ]]
  [[ "$(cat "$REPO"/tmp/ai/backup/*/.claude/settings.json)" == *'"model": "opus"'* ]]
  [[ "$(cat "$REPO/.claude/settings.local.json")" == *'"local": true'* ]]
}

@test "check passes right after a sync" {
  "$AI/sync-ai.sh" claude >/dev/null

  run "$AI/sync-ai.sh" --check claude

  [ "$status" -eq 0 ]
  [[ "$output" == *"OK: claude:"*"files up to date"* ]]
}

@test "check fails on an out-of-date or missing file" {
  "$AI/sync-ai.sh" claude >/dev/null
  printf 'edited\n' >"$REPO/.claude/commands/check.md"
  rm "$REPO/.mcp.json"

  run "$AI/sync-ai.sh" --check claude

  [ "$status" -eq 1 ]
  [[ "$output" == *"ERROR: claude: .claude/commands/check.md is out of date"* ]]
  [[ "$output" == *"ERROR: claude: .mcp.json is missing"* ]]
  [[ "$output" == *"fix: ai/sync-ai.sh claude"* ]]
}

@test "check fails on a stale generated file" {
  ai_command audit "Audit"
  "$AI/sync-ai.sh" claude >/dev/null
  rm "$AI/commands/audit.md"

  run "$AI/sync-ai.sh" --check claude

  [ "$status" -eq 1 ]
  [[ "$output" == *"claude: .claude/commands/audit.md is stale"* ]]
}

@test "check skips an agent that was never synced" {
  run "$AI/sync-ai.sh" --check claude

  [ "$status" -eq 0 ]
  [[ "$output" == *"OK: claude: not synced on this machine (skipped)"* ]]
}

@test "check writes nothing" {
  run "$AI/sync-ai.sh" --check claude

  [ ! -e "$REPO/.claude" ]
  [ ! -e "$REPO/.mcp.json" ]
}

@test "clean removes generated files and keeps the rest" {
  "$AI/sync-ai.sh" claude >/dev/null
  printf 'mine\n' >"$REPO/.claude/commands/mine.md"
  printf '{\n  "local": true\n}\n' >"$REPO/.claude/settings.local.json"

  run "$AI/sync-ai.sh" --clean claude

  [ "$status" -eq 0 ]
  [ ! -e "$REPO/.claude/settings.json" ]
  [ ! -e "$REPO/.mcp.json" ]
  [ ! -e "$REPO/.claude/skills" ]
  [ -f "$REPO/.claude/commands/mine.md" ]
  [ -f "$REPO/.claude/settings.local.json" ]

  run "$AI/sync-ai.sh" --check claude

  [[ "$output" == *"not synced on this machine"* ]]
}

@test "a source error writes nothing" {
  printf -- '---\nargument-hint: x\n---\n' >"$AI/commands/broken.md"

  run "$AI/sync-ai.sh" claude

  [ "$status" -eq 1 ]
  [ ! -e "$REPO/.claude" ]
  [ ! -e "$REPO/tmp/ai/state.json" ]
}

@test "no servers and no hooks means no settings or MCP file" {
  rm "$AI/mcp.json" "$AI/hooks/hooks.toml"

  run "$AI/sync-ai.sh" claude

  [ "$status" -eq 0 ]
  [ ! -e "$REPO/.claude/settings.json" ]
  [ ! -e "$REPO/.mcp.json" ]
  [ -f "$REPO/.claude/commands/check.md" ]
}

@test "sync warns when the installed agent differs from the tested version" {
  zc_stub claude 0 "9.9.9 (Claude Code)"

  run "$AI/sync-ai.sh" claude

  [ "$status" -eq 0 ]
  [[ "$output" == *"WARN: claude 9.9.9 is installed; this setup was tested with 2.1.330"* ]]
}

@test "sync warns when the agent is not installed" {
  rm "$BATS_TEST_TMPDIR/stubs/claude"
  zc_hide_command claude

  run "$AI/sync-ai.sh" claude

  [ "$status" -eq 0 ]
  [[ "$output" == *"WARN: claude is not installed"* ]]
  [ -f "$REPO/.claude/commands/check.md" ]
}

@test "a repository path with a double quote is refused" {
  quoted="$BATS_TEST_TMPDIR/re\"po"
  mv "$REPO" "$quoted"

  run "$quoted/ai/sync-ai.sh" claude

  [ "$status" -eq 1 ]
  [[ "$output" == *"contains a double quote"* ]]
}

opencode_servers() {
  cat >"$AI/mcp.json" <<'EOF'
{
  "mcpServers": {
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "opencode": {
        "headers": {
          "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
        }
      }
    },
    "local": {
      "type": "stdio",
      "command": "serve-docs",
      "args": [
        "--stdio"
      ],
      "env": {
        "DOCS": "1"
      }
    }
  }
}
EOF
}

@test "sync opencode writes commands, skills, MCP config and the plugin" {
  opencode_servers

  run "$AI/sync-ai.sh" opencode

  [ "$status" -eq 0 ]
  [ -f "$REPO/.opencode/commands/check.md" ]
  [ -x "$REPO/.opencode/skills/run-checks/run.sh" ]
  [ "$(json_get "$REPO/.opencode/opencode.json" "\$schema")" = '"https://opencode.ai/config.json"' ]
  [ "$(json_get "$REPO/.opencode/opencode.json" mcp servers context7 type)" = '"remote"' ]
  [ "$(json_get "$REPO/.opencode/opencode.json" mcp servers context7 headers CONTEXT7_API_KEY)" = '"{env:CONTEXT7_API_KEY}"' ]
  [ "$(json_get "$REPO/.opencode/opencode.json" mcp servers context7 oauth)" = 'false' ]
  [ "$(json_get "$REPO/.opencode/opencode.json" mcp servers local type)" = '"local"' ]
  [ "$(json_get "$REPO/.opencode/opencode.json" mcp servers local command)" = '["serve-docs", "--stdio"]' ]
  [ "$(json_get "$REPO/.opencode/opencode.json" mcp servers local environment)" = '{"DOCS": "1"}' ]
  [ ! -e "$REPO/opencode.json" ]
}

@test "an opencode command drops keys OpenCode does not define" {
  printf -- '---\ndescription: Audit\nargument-hint: [mode]\n---\n\nRun it.\n' >"$AI/commands/audit.md"

  run "$AI/sync-ai.sh" opencode

  [ "$status" -eq 0 ]
  [ "$(cat "$REPO/.opencode/commands/audit.md")" = "$(printf -- '---\ndescription: "Audit"\n---\n\nRun it.')" ]
}

@test "the opencode plugin calls hook.sh for the watched tools" {
  run "$AI/sync-ai.sh" opencode

  plugin="$REPO/.opencode/plugins/zambelz-dev-env/index.ts"

  [ "$status" -eq 0 ]
  grep -qF "const hookScript = \"$AI/hook.sh\"" "$plugin"
  grep -qF 'const watchedTools: readonly string[] = ["shell", "write", "edit", "apply_patch", "patch"]' "$plugin"
  grep -qF 'const checkBefore = true' "$plugin"
  grep -qF 'const checkAfter = true' "$plugin"
  grep -qF 'id: "zambelz-dev-env"' "$plugin"

  run grep -c "@@" "$plugin"

  [ "$output" = "0" ]
}

@test "the opencode plugin skips events no hook subscribes to" {
  cat >"$AI/hooks/hooks.toml" <<'EOF'
[[hook]]
name = "guard"
module = "guard"
events = ["tool.before"]
summary = "Guards"
EOF

  run "$AI/sync-ai.sh" opencode

  [ "$status" -eq 0 ]
  grep -qF 'const checkBefore = true' "$REPO/.opencode/plugins/zambelz-dev-env/index.ts"
  grep -qF 'const checkAfter = false' "$REPO/.opencode/plugins/zambelz-dev-env/index.ts"
}

@test "no hooks means no opencode plugin and no MCP means no config" {
  rm "$AI/mcp.json" "$AI/hooks/hooks.toml"

  run "$AI/sync-ai.sh" opencode

  [ "$status" -eq 0 ]
  [ ! -e "$REPO/.opencode/plugins" ]
  [ ! -e "$REPO/.opencode/opencode.json" ]
}

@test "sync opencode leaves the tracked root opencode.json and other .opencode files alone" {
  printf '{\n  "instructions": [\n    "README.md"\n  ]\n}\n' >"$REPO/opencode.json"
  mkdir -p "$REPO/.opencode/plugins/mine"
  printf 'export default {}\n' >"$REPO/.opencode/plugins/mine/index.ts"

  run "$AI/sync-ai.sh" opencode

  [ "$status" -eq 0 ]
  [[ "$(cat "$REPO/opencode.json")" == *'"README.md"'* ]]
  [ -f "$REPO/.opencode/plugins/mine/index.ts" ]

  run "$AI/sync-ai.sh" --clean opencode

  [ "$status" -eq 0 ]
  [ -f "$REPO/opencode.json" ]
  [ -f "$REPO/.opencode/plugins/mine/index.ts" ]
  [ ! -e "$REPO/.opencode/plugins/zambelz-dev-env" ]
  [ ! -e "$REPO/.opencode/commands" ]
}

@test "check opencode passes right after a sync" {
  "$AI/sync-ai.sh" opencode >/dev/null

  run "$AI/sync-ai.sh" --check opencode

  [ "$status" -eq 0 ]
}
